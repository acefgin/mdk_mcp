{
  "mcpServers": {
    "mdk-ts-mcp": {
      "command": "wsl",
      "args": [
        "-e",
        "bash",
        "-c",
        "cd /home/cxl/MDK_Design/mdk_mcp && node workspace/mcp-server.js"
      ],
      "env": {
        "DEBUG": "false"
      }
    },
    "code-execution-sandbox": {
      "command": "wsl",
      "args": [
        "-e",
        "bash",
        "-c",
        "docker exec -i code-execution-sandbox node /app/dist/executor.js"
      ]
    }
  }
}


