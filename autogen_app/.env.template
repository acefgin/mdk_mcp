# AutoGen qPCR Assistant Configuration

# =============================================================================
# API Keys - Choose Your Provider
# =============================================================================

# OpenRouter API Key (Recommended - gives access to 100+ models)
# Get your key from: https://openrouter.ai/keys
# Supports: Claude, GPT-4, Gemini, Llama, DeepSeek, Mistral, and many more
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI API Key (Optional - for direct OpenAI access)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google AI API Key (Optional - for direct Google Gemini access)
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# NCBI API Key (Optional - for higher rate limits on sequence retrieval)
# Get your key from: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# =============================================================================
# Model Selection - Change this to switch models easily
# =============================================================================

# Recommended Models (via OpenRouter):
# - anthropic/claude-3.5-sonnet      (Best balance - Recommended for production)
# - anthropic/claude-3-opus          (Most capable - Use for complex tasks)
# - anthropic/claude-3-haiku         (Fast and cheap - Good for development)
# - openai/gpt-4o                    (Latest GPT-4 via OpenRouter)
# - openai/gpt-4o-mini               (Fast and cheap via OpenRouter)
# - google/gemini-2.0-flash-001      (Fast via OpenRouter)
# - deepseek/deepseek-chat           (Very cheap - Budget option)
# - meta-llama/llama-3.1-70b-instruct (Open source via OpenRouter)
# - mistralai/mistral-large          (European AI via OpenRouter)
#
# Direct Provider Models (no OpenRouter needed):
# - gpt-4o                           (Direct OpenAI - requires OPENAI_API_KEY)
# - gpt-4o-mini                      (Direct OpenAI - requires OPENAI_API_KEY)
# - gemini-2.5-flash-lite            (Direct Google - requires GOOGLE_API_KEY)

MODEL_NAME=anthropic/claude-3.5-sonnet

# =============================================================================
# AutoGen Configuration
# =============================================================================

AUTOGEN_MAX_ROUNDS=20
AUTOGEN_TEMPERATURE=0.7

# =============================================================================
# MCP Server Configuration
# =============================================================================

MCP_DATABASE_SERVER=ndiag-database-server
MCP_PROCESSING_SERVER=ndiag-processing-server
# MCP_ALIGNMENT_SERVER=ndiag-alignment-server    # Phase 3 (coming soon)
# MCP_DESIGN_SERVER=ndiag-design-server          # Phase 4 (coming soon)

# =============================================================================
# Logging
# =============================================================================

LOG_LEVEL=INFO

# =============================================================================
# Quick Start Guide
# =============================================================================
#
# 1. Copy this file: cp .env.template .env
# 2. Choose ONE of the following:
#
#    Option A: Use OpenRouter (Recommended - access to all models)
#      - Get API key: https://openrouter.ai/keys
#      - Add credits to your account ($5-10 to start)
#      - Set OPENROUTER_API_KEY above
#      - Choose MODEL_NAME from OpenRouter options
#
#    Option B: Use OpenAI directly
#      - Get API key: https://platform.openai.com/api-keys
#      - Set OPENAI_API_KEY above
#      - Set MODEL_NAME=gpt-4o or MODEL_NAME=gpt-4o-mini
#
#    Option C: Use Google AI directly
#      - Get API key: https://makersuite.google.com/app/apikey
#      - Set GOOGLE_API_KEY above
#      - Set MODEL_NAME=gemini-2.5-flash-lite
#
# 3. Run: python qpcr_assistant.py
#
# For detailed documentation, see:
# - QUICKSTART_OPENROUTER.md
# - OPENROUTER_GUIDE.md
# - README_MODELS.md
# =============================================================================
