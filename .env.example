# Environment Configuration Template
# Copy this file to .env and fill in your values

# Logging
LOG_LEVEL=INFO
LOG_DESTINATION=stderr
LOG_PRETTY=false

# Execution Settings
EXECUTION_TIMEOUT=30000
MAX_OUTPUT_SIZE=1048576

# Transport Settings
TRANSPORT_TYPE=docker-exec
TRANSPORT_TIMEOUT=30000

# Cache Settings
CACHE_ENABLED=true
CACHE_SCHEMA_TTL=300000
CACHE_TOOL_LIST_TTL=600000

# Server Timeouts (ms)
DATABASE_TIMEOUT=30000
PROCESSING_TIMEOUT=60000
ALIGNMENT_TIMEOUT=120000
DESIGN_TIMEOUT=60000
VALIDATION_TIMEOUT=60000

# API Keys (if needed)
# NCBI_API_KEY=your_key_here
# BOLD_API_KEY=your_key_here
