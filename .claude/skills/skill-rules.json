{
    "version": "1.0",
    "description": "Skill activation triggers for mdk_mcp - Python-based bioinformatics MCP platform",
    "skills": {
        "skill-developer": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Meta-skill for creating and managing Claude Code skills",
            "promptTriggers": {
                "keywords": [
                    "skill system",
                    "create skill",
                    "add skill",
                    "skill triggers",
                    "skill rules",
                    "hook system",
                    "skill development",
                    "skill-rules.json"
                ],
                "intentPatterns": [
                    "(how do|how does|explain).*?skill",
                    "(create|add|modify|build).*?skill",
                    "skill.*?(work|trigger|activate|system)"
                ]
            }
        },
        "mcp-server-dev": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "MCP server development patterns for Python-based bioinformatics tools",
            "promptTriggers": {
                "keywords": [
                    "MCP server",
                    "MCP tool",
                    "mcp tool",
                    "server development",
                    "tool handler",
                    "handle_call_tool",
                    "handle_list_tools",
                    "types.Tool",
                    "inputSchema",
                    "stdio server",
                    "bioinformatics tool"
                ],
                "intentPatterns": [
                    "(create|add|implement|build).*?(MCP|mcp).*?(server|tool)",
                    "(add|create).*?(tool|handler).*?(MCP|mcp)",
                    "(implement|build).*?(database|processing|alignment|design).*?server",
                    "(how to|best practice).*?(MCP|mcp).*?(tool|server)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "mcp_servers/**/*_mcp_server.py",
                    "mcp_servers/**/config.py",
                    "mcp_servers/**/tests/*.py"
                ],
                "pathExclusions": [
                    "**/__pycache__/**",
                    "**/*.pyc"
                ],
                "contentPatterns": [
                    "@server\\.list_tools",
                    "@server\\.call_tool",
                    "types\\.Tool",
                    "inputSchema",
                    "async def handle_"
                ]
            }
        },
        "ag2-agent-dev": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "AG2 (AutoGen) multi-agent development patterns for orchestration",
            "promptTriggers": {
                "keywords": [
                    "AG2",
                    "AutoGen",
                    "agent",
                    "multi-agent",
                    "agent collaboration",
                    "ConversableAgent",
                    "AssistantAgent",
                    "UserProxyAgent",
                    "GroupChat",
                    "agent orchestration",
                    "workflow coordination"
                ],
                "intentPatterns": [
                    "(create|add|implement|build).*?agent",
                    "(setup|configure).*?(AG2|AutoGen|multi-agent)",
                    "(how to|best practice).*?agent.*?(collaboration|orchestration)",
                    "(define|create).*?agent.*?(role|capability)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "autogen_app/**/*.py",
                    "autogen_app/OAI_CONFIG_LIST.json"
                ],
                "pathExclusions": [
                    "**/__pycache__/**",
                    "**/*.pyc"
                ],
                "contentPatterns": [
                    "ConversableAgent",
                    "AssistantAgent",
                    "UserProxyAgent",
                    "GroupChat",
                    "from.*autogen",
                    "import.*autogen"
                ]
            }
        },
        "python-dev-guidelines": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Python development best practices for async/await, type hints, and testing",
            "promptTriggers": {
                "keywords": [
                    "python",
                    "async",
                    "await",
                    "type hints",
                    "typing",
                    "pytest",
                    "python testing",
                    "python best practice",
                    "async function",
                    "coroutine"
                ],
                "intentPatterns": [
                    "(write|create|implement).*?python.*?(function|class|module)",
                    "(add|implement).*?(async|await|type.*?hint)",
                    "(how to|best practice).*?python",
                    "(test|testing).*?python.*?(function|class)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "**/*.py"
                ],
                "pathExclusions": [
                    "**/__pycache__/**",
                    "**/*.pyc",
                    "**/tests/**",
                    "**/test_*.py"
                ],
                "contentPatterns": [
                    "async def",
                    "await ",
                    "from typing import",
                    "import typing"
                ]
            }
        },
        "biopython-dev": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "BioPython best practices for sequence parsing, database access, phylogenetics, and file I/O",
            "promptTriggers": {
                "keywords": [
                    "BioPython",
                    "Biopython",
                    "SeqIO",
                    "Entrez",
                    "Phylo",
                    "AlignIO",
                    "SeqRecord",
                    "Seq object",
                    "parse FASTA",
                    "parse GenBank",
                    "NCBI query",
                    "phylogenetic tree",
                    "distance matrix",
                    "alignment I/O",
                    "sequence parsing"
                ],
                "intentPatterns": [
                    "(parse|read|write).*?(FASTA|GenBank|sequence.*?file)",
                    "(create|build).*?(phylogenetic|phylogeny).*?tree",
                    "(fetch|retrieve|query).*?(NCBI|Entrez)",
                    "(use|using|with).*?(BioPython|SeqIO|Phylo|AlignIO)",
                    "(extract|get).*?(sequence.*?metadata|SeqRecord)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "mcp_servers/**/*.py"
                ],
                "pathExclusions": [
                    "**/__pycache__/**",
                    "**/*.pyc"
                ],
                "contentPatterns": [
                    "from Bio import",
                    "import Bio\\.",
                    "SeqIO\\.parse",
                    "SeqIO\\.write",
                    "Entrez\\.",
                    "Phylo\\.",
                    "AlignIO\\.",
                    "SeqRecord",
                    "MultipleSeqAlignment"
                ]
            }
        },
        "primer-design-tools": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Primer3, ViennaRNA, and qPCR primer design patterns for species-specific diagnostics",
            "promptTriggers": {
                "keywords": [
                    "Primer3",
                    "primer design",
                    "qPCR primer",
                    "ViennaRNA",
                    "secondary structure",
                    "hairpin",
                    "primer dimer",
                    "homodimer",
                    "heterodimer",
                    "melting temperature",
                    "Tm calculation",
                    "signature region",
                    "oligo",
                    "oligonucleotide",
                    "GC content",
                    "primer quality"
                ],
                "intentPatterns": [
                    "(design|create|find).*?primer",
                    "(calculate|compute).*?(Tm|melting.*?temperature)",
                    "(check|analyze|predict).*?(secondary.*?structure|hairpin|dimer)",
                    "(find|discover|identify).*?signature.*?region",
                    "(use|using|with).*?(Primer3|ViennaRNA)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "mcp_servers/design_server/**/*.py"
                ],
                "contentPatterns": [
                    "import primer3",
                    "primer3\\.design",
                    "RNAfold",
                    "RNAduplex",
                    "ViennaRNA",
                    "find_signature_regions",
                    "calculate.*tm",
                    "hairpin",
                    "homodimer"
                ]
            }
        },
        "seq-analysis-tools": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "CLI bioinformatics tools integration: seqkit, vsearch, MAFFT, MUSCLE, Clustal Omega",
            "promptTriggers": {
                "keywords": [
                    "seqkit",
                    "vsearch",
                    "MAFFT",
                    "MUSCLE",
                    "Clustal Omega",
                    "clustalo",
                    "subprocess",
                    "CLI tool",
                    "command line tool",
                    "external tool",
                    "alignment strategy",
                    "clustering",
                    "dereplication",
                    "chimera detection",
                    "low complexity masking",
                    "FASTA statistics",
                    "sequence filtering",
                    "DUST masking",
                    "UCHIME"
                ],
                "intentPatterns": [
                    "(run|execute|call).*?(CLI|command.*?line|external).*?tool",
                    "(use|integrate|with).*?(seqkit|vsearch|MAFFT|MUSCLE|Clustal)",
                    "(create|use).*?subprocess",
                    "(alignment|align).*?strategy",
                    "(cluster|dereplicate|chimera|mask).*?sequence"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "mcp_servers/processing_server/**/*.py",
                    "mcp_servers/alignment_server/**/*.py"
                ],
                "contentPatterns": [
                    "asyncio\\.create_subprocess_exec",
                    "subprocess\\.run",
                    "seqkit",
                    "vsearch",
                    "mafft",
                    "muscle",
                    "clustalo",
                    "--derep",
                    "--cluster",
                    "--uchime"
                ]
            }
        },
