                    "primer",
                    "alignment",
                    "phylogeny",
                    "FASTA",
                    "GenBank",
                    "COI",
                    "16S",
                    "ITS",
                    "taxonomy",
                    "species identification",
                    "signature region",
                    "sequence analysis",
                    "quality control",
                    "dereplicate",
                    "chimera"
                ],
                "intentPatterns": [
                    "(design|create|find).*?(primer|qPCR|assay)",
                    "(retrieve|get|fetch).*?sequence",
                    "(align|alignment|phylogeny).*?sequence",
                    "(analyze|analysis).*?(sequence|FASTA|alignment)",
                    "(quality control|QC|filter).*?sequence"
                ]
