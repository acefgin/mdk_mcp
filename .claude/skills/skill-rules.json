        "docker-container-dev": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "medium",
            "description": "Docker containerization patterns for MCP servers and services",
            "promptTriggers": {
                "keywords": [
                    "Docker",
                    "Dockerfile",
                    "docker-compose",
                    "container",
                    "containerize",
                    "docker build",
                    "docker image",
                    "docker network"
                ],
                "intentPatterns": [
                    "(create|build|update).*?(Dockerfile|docker.*?compose)",
                    "(containerize|dockerize).*?(server|service|application)",
