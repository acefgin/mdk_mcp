        "testing-and-qa": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "medium",
            "description": "Testing patterns for MCP servers, agents, and bioinformatics pipelines",
            "promptTriggers": {
                "keywords": [
                    "test",
                    "testing",
                    "pytest",
                    "unit test",
                    "integration test",
                    "test coverage",
                    "mock",
                    "fixture",
                    "test case"
                ],
                "intentPatterns": [
                    "(write|create|add).*?test",
                    "(test|testing).*?(function|class|tool|server)",
                    "(how to|best practice).*?(test|testing|pytest)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "**/tests/**/*.py",
                    "**/test_*.py",
                    "**/*_test.py"
                ],
                "contentPatterns": [
                    "import pytest",
                    "def test_",
                    "@pytest\\.fixture",
                    "@pytest\\.mark"
                ]
