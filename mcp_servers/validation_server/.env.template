# Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8004

# NCBI Configuration (REQUIRED for PubMed)
NCBI_EMAIL=your.email@example.com  # REQUIRED: Set your email for NCBI API
NCBI_API_KEY=  # OPTIONAL: Get from https://www.ncbi.nlm.nih.gov/account/settings/

# Directories
TEMP_DIR=/tmp/mcp_validation
BLAST_CACHE_DIR=/tmp/mcp_validation/blast_cache

# Processing Limits
MAX_SEQUENCES=10000
MAX_FILE_SIZE_MB=200
MAX_QUERY_LENGTH=10000

# BLAST Configuration
DEFAULT_BLAST_PROGRAM=blastn
DEFAULT_BLAST_DATABASE=nt
DEFAULT_BLAST_LIMIT=50
DEFAULT_BLAST_EVALUE=10.0
DEFAULT_BLAST_PERC_IDENTITY=90.0

# BLAST Database Paths (following NCBI best practices)
# See: https://github.com/ncbi/blast_plus_docs
#
# By default, the server uses remote BLAST via gget (no local databases needed)
# For local BLAST support, download databases and set paths:
#
# Option 1: Use BLASTDB environment variable (recommended)
#   BLASTDB=/path/to/blastdb
#
# Option 2: Set specific database paths
#   NT_DATABASE=/blastdb/nt
#   NR_DATABASE=/blastdb/nr
#
# To download BLAST databases:
#   update_blastdb.pl --decompress nt
#   update_blastdb.pl --decompress nr
#
# Or using docker-compose, mount your local databases:
#   volumes:
#     - /your/path/to/blastdb:/blastdb:ro
#
# Database sizes (approximate):
#   nt: ~70GB compressed, ~300GB uncompressed
#   nr: ~100GB compressed, ~400GB uncompressed
BLASTDB=
NT_DATABASE=
NR_DATABASE=

# In-silico PCR Configuration
DEFAULT_MAX_MISMATCHES=2
DEFAULT_MIN_PRODUCT_SIZE=50
DEFAULT_MAX_PRODUCT_SIZE=500

# Coverage Assessment Thresholds
VALIDATION_MIN_SENSITIVITY=0.90
VALIDATION_MIN_SPECIFICITY=0.95
VALIDATION_MAX_OFFTARGET_HITS=5

# PubMed Configuration
DEFAULT_PUBMED_MAX_RESULTS=20
DEFAULT_PUBMED_SORT=relevance

# Logging
LOG_LEVEL=INFO
