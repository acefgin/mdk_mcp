# Processing MCP Server Configuration Template
# Copy this file to .env and customize as needed

# Logging
LOG_LEVEL=INFO

# Temporary files
TEMP_DIR=/tmp/mcp_processing

# Processing limits
MAX_SEQUENCES=10000
MAX_FILE_SIZE_MB=100

# Tool paths (use command names if in PATH)
SEQKIT_PATH=seqkit
VSEARCH_PATH=vsearch

# QC defaults
DEFAULT_MIN_LENGTH=100
DEFAULT_MAX_N_PERCENT=5.0

# Dereplication defaults
DEFAULT_IDENTITY_THRESHOLD=0.97

# Masking defaults
DEFAULT_MIN_COMPLEXITY=1.5

# Chimera detection defaults
DEFAULT_ABUNDANCE_SKEW=2.0
